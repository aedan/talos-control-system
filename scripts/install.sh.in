#!/usr/bin/env bash
# Talos Control System — self-extracting installer
# Generated by scripts/package-installer.sh (payload appended after __ARCHIVE_BELOW__).
#
# Usage:
#   sudo ./tcs-*-linux-*.sh
#   sudo ./tcs-*-linux-*.sh --prefix /opt/tcs
#   sudo TCS_DEFAULT_ADMIN_PASSWORD=... ./tcs-*-linux-*.sh
#
# Environment:
#   TCS_CONFIG_PATH       default /etc/tcs/config.toml
#   TCS_DATA_DIR          default /var/lib/tcs
#   TCS_BIN_PATH          default /usr/local/bin/tcs
#   TCS_SKIP_START        set to 1 to install without starting the service
#   TCS_ALLOW_INSECURE    written into /etc/tcs/env for lab installs if set

set -euo pipefail

TCS_VERSION="__VERSION__"
TCS_COMMIT="__COMMIT__"
ARCHIVE_MARKER="__ARCHIVE_BELOW__"

TCS_BIN="${TCS_BIN_PATH:-/usr/local/bin/tcs}"
TCS_CONFIG_DIR="${TCS_CONFIG_DIR:-/etc/tcs}"
TCS_CONFIG="${TCS_CONFIG_PATH:-${TCS_CONFIG_DIR}/config.toml}"
TCS_ENV="${TCS_CONFIG_DIR}/env"
TCS_DATA="${TCS_DATA_DIR:-/var/lib/tcs}"
SYSTEMD_UNIT="/etc/systemd/system/tcs.service"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'
info() { echo -e "${GREEN}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }

usage() {
  cat <<EOF
Talos Control System installer v${TCS_VERSION} (commit ${TCS_COMMIT})

Installs a single host binary + systemd unit. TCS manages Talos from outside
the cluster — it does not run in Kubernetes.

Options:
  -h, --help     Show this help
  --no-start     Install files only; do not enable/start systemd unit
  --upgrade      Stop service, replace binary, keep config, restart
EOF
}

NO_START=0
UPGRADE=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --no-start) NO_START=1; shift ;;
    --upgrade) UPGRADE=1; shift ;;
    *) err "Unknown option: $1"; usage; exit 1 ;;
  esac
done

if [ "$(id -u)" -ne 0 ]; then
  err "Run as root (sudo)"
  exit 1
fi

if ! command -v systemctl >/dev/null 2>&1; then
  err "systemd (systemctl) is required"
  exit 1
fi

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64|amd64) ARCH="x86_64" ;;
  aarch64|arm64) ARCH="aarch64" ;;
  *) err "Unsupported architecture: $ARCH"; exit 1 ;;
esac

info "Installing Talos Control System v${TCS_VERSION} (${ARCH}, commit ${TCS_COMMIT})"

# Locate archive payload in this script
SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
ARCHIVE_LINE="$(awk "/^${ARCHIVE_MARKER}\$/ {print NR + 1; exit 0}" "$SCRIPT_PATH")"
if [ -z "${ARCHIVE_LINE}" ]; then
  err "Installer payload missing (corrupt download?)"
  exit 1
fi

EXTRACT_DIR="$(mktemp -d)"
trap 'rm -rf "$EXTRACT_DIR"' EXIT

info "Extracting payload..."
tail -n +"${ARCHIVE_LINE}" "$SCRIPT_PATH" | tar xz -C "$EXTRACT_DIR"

if [ ! -f "${EXTRACT_DIR}/tcs" ]; then
  err "Binary 'tcs' not found in payload"
  exit 1
fi

if systemctl is-active --quiet tcs 2>/dev/null; then
  info "Stopping existing tcs service..."
  systemctl stop tcs || true
fi

install -d -m 0755 "$(dirname "$TCS_BIN")"
install -m 0755 "${EXTRACT_DIR}/tcs" "$TCS_BIN"
info "Installed binary → ${TCS_BIN}"

# ─── Install / update talosctl ───────────────────────────────────────
TALOSCTL_VERSION="1.13.8"
TALOSCTL_BIN="/usr/local/bin/talosctl"

install_talosctl() {
  local need_install=1
  if [ -x "$TALOSCTL_BIN" ]; then
    local existing_ver
    existing_ver="$($TALOSCTL_BIN version --client -o json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('talosversion',''))" 2>/dev/null || true)"
    if [ "$existing_ver" = "v${TALOSCTL_VERSION}" ]; then
      info "talosctl v${TALOSCTL_VERSION} already installed at ${TALOSCTL_BIN}"
      need_install=0
    fi
  fi

  if [ "$need_install" = "1" ]; then
    info "Installing talosctl v${TALOSCTL_VERSION}..."
    local tbin
    case "$ARCH" in
      x86_64)   tbin="talosctl-linux-amd64" ;;
      aarch64)  tbin="talosctl-linux-arm64" ;;
    esac
    local turl="https://github.com/siderolabs/talos/releases/download/v${TALOSCTL_VERSION}/${tbin}"
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o "${EXTRACT_DIR}/talosctl" "$turl"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "${EXTRACT_DIR}/talosctl" "$turl"
    else
      warn "Cannot install talosctl: no curl or wget. Install manually from GitHub releases."
      return
    fi
    chmod +x "${EXTRACT_DIR}/talosctl"
    install -m 0755 "${EXTRACT_DIR}/talosctl" "$TALOSCTL_BIN"
    info "Installed talosctl → ${TALOSCTL_BIN}"
  fi
}

install_talosctl

# ─── Install / update kubectl ─────────────────────────────────────────
KUBECTL_VERSION="1.31.4"
KUBECTL_BIN="/usr/local/bin/kubectl"

install_kubectl() {
  local need_install=1
  if [ -x "$KUBECTL_BIN" ]; then
    local existing_ver
    existing_ver="$($KUBECTL_BIN version --client -o json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('clientVersion',{}).get('gitVersion',''))" 2>/dev/null || true)"
    if [ "$existing_ver" = "v${KUBECTL_VERSION}" ]; then
      info "kubectl v${KUBECTL_VERSION} already installed at ${KUBECTL_BIN}"
      need_install=0
    fi
  fi

  if [ "$need_install" = "1" ]; then
    info "Installing kubectl v${KUBECTL_VERSION}..."
    local karch
    case "$ARCH" in
      x86_64)   karch="amd64" ;;
      aarch64)  karch="arm64" ;;
    esac
    local kurl="https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${karch}/kubectl"
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o "${EXTRACT_DIR}/kubectl" "$kurl"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "${EXTRACT_DIR}/kubectl" "$kurl"
    else
      warn "Cannot install kubectl: no curl or wget. Install manually from dl.k8s.io."
      return
    fi
    chmod +x "${EXTRACT_DIR}/kubectl"
    install -m 0755 "${EXTRACT_DIR}/kubectl" "$KUBECTL_BIN"
    info "Installed kubectl → ${KUBECTL_BIN}"
  fi
}

install_kubectl

# ─── Install / update helm ────────────────────────────────────────────
HELM_VERSION="3.16.2"
HELM_BIN="/usr/local/bin/helm"

install_helm() {
  local need_install=1
  if [ -x "$HELM_BIN" ]; then
    local existing_ver
    existing_ver="$($HELM_BIN version -o json 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('version',''))" 2>/dev/null || true)"
    if [ "$existing_ver" = "v${HELM_VERSION}" ]; then
      info "helm v${HELM_VERSION} already installed at ${HELM_BIN}"
      need_install=0
    fi
  fi

  if [ "$need_install" = "1" ]; then
    info "Installing helm v${HELM_VERSION}..."
    local harch
    case "$ARCH" in
      x86_64)   harch="amd64" ;;
      aarch64)  harch="arm64" ;;
    esac
    local htar="helm-v${HELM_VERSION}-linux-${harch}.tar.gz"
    local hurl="https://get.helm.sh/${htar}"
    local htmp="${EXTRACT_DIR}/helm.tgz"
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o "$htmp" "$hurl"
    elif command -v wget >/dev/null 2>&1; then
      wget -q -O "$htmp" "$hurl"
    else
      warn "Cannot install helm: no curl or wget. Install manually from get.helm.sh."
      return
    fi
    tar xzf "$htmp" -C "${EXTRACT_DIR}" "linux-${harch}/helm"
    install -m 0755 "${EXTRACT_DIR}/linux-${harch}/helm" "$HELM_BIN"
    info "Installed helm → ${HELM_BIN}"
  fi
}

install_helm

# ─── Zero-touch tool wrappers ─────────────────────────────────────────
# /opt/tcs/bin/{helm,kubectl,talosctl}: when the cred env var is unset and
# this host runs TCS, fetch the cluster's kubeconfig/talosconfig over the TCS
# API (using the caller's token; auto re-login if expired) into a 0600 tmpfs
# file and run the real tool. The real tool is always invoked by absolute path
# (/usr/local/bin/...), so TCS's own server-side passthrough and internal
# talosctl spawns never recurse into the wrappers. The credential is decrypted
# server-side — it is never read directly from the TCS database.
TCS_TOOLS_DIR="/opt/tcs/bin"

install_tcs_tool_wrappers() {
  install -d -m 0755 "$TCS_TOOLS_DIR"

  local tool cred_env tcs_verb real
  for tool in helm kubectl talosctl; do
    case "$tool" in
      talosctl) cred_env="TALOSCONFIG"; tcs_verb="talosconfig" ;;
      *)        cred_env="KUBECONFIG";  tcs_verb="kubeconfig" ;;
    esac
    real="/usr/local/bin/${tool}"
    cat > "${TCS_TOOLS_DIR}/${tool}" <<EOF
 #!/usr/bin/env bash
# TCS zero-touch wrapper for ${tool}. Generated by the TCS installer.
# Passes through to the real ${tool} when TCS is not in play; otherwise
# injects the cluster's ${tcs_verb} fetched over the TCS API (token auth).
set -u

# 1. Explicit credentials already set -> pass through.
if [ -n "\${${cred_env}:-}" ]; then
  exec ${real} "\$@"
fi

# 2. TCS-internal spawn (the tcs server runs talosctl itself) -> pass through.
if [ "\${TCS_INTERNAL:-}" = "1" ]; then
  exec ${real} "\$@"
fi

# 3. This host does not run TCS -> pass through (real tool errors as usual).
if [ ! -f /etc/tcs/config.toml ] || [ ! -x ${TCS_BIN} ]; then
  exec ${real} "\$@"
fi

# 4. Materialize the ${tcs_verb} over the TCS API using the caller's token.
#    A missing/expired token triggers an interactive `tcs login` (requires a
#    human at the terminal), matching the old `tcs kubectl` auth behavior.
#    The credential is decrypted server-side and never read from the DB directly.
if ! creds="\$(${TCS_BIN} ${tcs_verb})"; then
  echo "tcs: could not obtain ${tcs_verb} (login required or cluster has none)" >&2
  exec ${real} "\$@"
fi
[ -n "\${creds}" ] || exec ${real} "\$@"

tmp="\$(mktemp /dev/shm/tcs-${tcs_verb}.XXXXXX 2>/dev/null || mktemp)"
chmod 600 "\$tmp"
trap 'rm -f "\$tmp"' EXIT
printf '%s\n' "\${creds}" > "\$tmp"
export ${cred_env}="\$tmp"
# Run (not exec) so the EXIT trap removes the temp cred file.
${real} "\$@"
exit \$?
EOF
    chmod 0755 "${TCS_TOOLS_DIR}/${tool}"
  done

  # PATH shim: prepend /opt/tcs/bin for login shells.
  cat > /etc/profile.d/tcs-tools.sh <<'EOF'
case ":${PATH}:" in
  *":/opt/tcs/bin:"*) ;;
  *) PATH="/opt/tcs/bin:${PATH}" ;;
esac
export PATH
EOF
  chmod 0644 /etc/profile.d/tcs-tools.sh
  info "Tool wrappers → ${TCS_TOOLS_DIR}/{helm,kubectl,talosctl}"
  info "PATH shim → /etc/profile.d/tcs-tools.sh"
}

install_tcs_tool_wrappers

install -d -m 0755 "$TCS_CONFIG_DIR" "$TCS_DATA" "${TCS_DATA}/certs" "${TCS_DATA}/backups"

if [ ! -f "$TCS_CONFIG" ]; then
  if [ -f "${EXTRACT_DIR}/config.example.toml" ]; then
    install -m 0640 "${EXTRACT_DIR}/config.example.toml" "$TCS_CONFIG"
  else
    cat > "$TCS_CONFIG" <<'EOF'
[server]
bind_addr = "0.0.0.0"
advertised_url = ""
http_port = 8081
grpc_port = 8080
metrics_port = 9090

[database]
backend = "sqlite"
sqlite_path = "/var/lib/tcs/data.db"

[auth]
jwt_secret = "change-me-generate-with-openssl-rand-hex-32"

[tls]
enabled = false
mode = "disabled"
EOF
    chmod 0640 "$TCS_CONFIG"
  fi
  info "Created config → ${TCS_CONFIG}"
  warn "Edit ${TCS_CONFIG}: set auth.jwt_secret and server.advertised_url before production use"
else
  info "Keeping existing config → ${TCS_CONFIG}"
fi

# Env file for secrets / lab flags (does not overwrite existing values)
if [ ! -f "$TCS_ENV" ]; then
  umask 077
  JWT="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | xxd -p -c 32)"
  cat > "$TCS_ENV" <<EOF
# Environment for tcs.service (sourced by systemd EnvironmentFile)
TCS_AUTH_JWT_SECRET=${JWT}
# Uncomment for local lab only:
# TCS_ALLOW_INSECURE=1
# TCS_DEFAULT_ADMIN_PASSWORD=change-me
EOF
  chmod 0600 "$TCS_ENV"
  info "Created ${TCS_ENV} with a generated JWT secret"
else
  info "Keeping existing ${TCS_ENV}"
fi

cat > "$SYSTEMD_UNIT" <<UNIT
[Unit]
Description=Talos Control System
Documentation=https://github.com/aedan/talos-control-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${TCS_BIN} serve
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
Environment=TCS_CONFIG=${TCS_CONFIG}
# Real tools first: the service's internal talosctl spawn must never resolve
# to the zero-touch wrapper in /opt/tcs/bin.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-${TCS_ENV}

# Hardening (host service — not a container)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=${TCS_DATA} ${TCS_CONFIG_DIR} /var/log

[Install]
WantedBy=multi-user.target
UNIT

info "Installed systemd unit → ${SYSTEMD_UNIT}"
systemctl daemon-reload

if [ "$NO_START" = "1" ]; then
  info "Skipping enable/start (--no-start)"
  info "When ready: systemctl enable --now tcs"
else
  systemctl enable tcs.service
  info "Starting tcs..."
  systemctl start tcs.service
  sleep 1
  if systemctl is-active --quiet tcs; then
    info "TCS is active"
  else
    warn "Service may have failed — check: journalctl -u tcs -n 50"
  fi
fi

info ""
info "Install complete: TCS v${TCS_VERSION}"
info "  Binary:  ${TCS_BIN}"
info "  Config:  ${TCS_CONFIG}"
info "  Data:    ${TCS_DATA}"
info "  Env:     ${TCS_ENV}"
info "  Tools:   ${TCS_TOOLS_DIR}/{helm,kubectl,talosctl} (zero-touch wrappers)"
info "  Status:  systemctl status tcs"
info "  Logs:    journalctl -u tcs -f"
info ""
info "First boot admin password (if new DB):"
info "  journalctl -u tcs | grep -i 'Default admin password'"
info ""
info "TCS runs on the host and manages Talos clusters out-of-band (not in-cluster)."

exit 0

__ARCHIVE_BELOW__
