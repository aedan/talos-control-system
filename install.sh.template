# Talos Control System release installer
# Installs binary, systemd unit, config dir, and enables service.

set -euo pipefail

TCS_VERSION="VERSION_PLACEHOLDER"
TCS_BIN="/usr/local/bin/tcs"
TCS_CONFIG="/etc/tcs/config.toml"
TCS_DATA="/var/lib/tcs"
TCS_CERTS="/var/lib/tcs/certs"
TCS_LOG="/var/log/tcs"
SYSTEMD_UNIT="/etc/systemd/system/tcs.service"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# Must be root
if [ "$(id -u)" -ne 0 ]; then
    err "This installer must be run as root (sudo)"
    exit 1
fi

# Detect arch
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)  ARCH="x86_64" ;;
    aarch64) ARCH="aarch64" ;;
    arm64)   ARCH="aarch64" ;;
    *)       err "Unsupported architecture: $ARCH"; exit 1 ;;
esac

info "Installing Talos Control System v${TCS_VERSION} (${ARCH})"

# Extract payload
info "Extracting..."
EXTRACT_DIR="$(mktemp -d)"
PAYLOAD_FILE="$(echo "tcs-${TCS_VERSION}-linux-${ARCH}.tar.gz")"
tar xzf <(tail -n +1 "$0" 2>/dev/null || cat) -C "$EXTRACT_DIR"

# Install binary
if [ -f "$TCS_BIN" ]; then
    info "Stopping existing TCS service..."
    systemctl stop tcs.service 2>/dev/null || true
fi

cp "${EXTRACT_DIR}/tcs" "$TCS_BIN"
chmod +x "$TCS_BIN"
info "Installed binary to ${TCS_BIN}"

# Create directories
mkdir -p "$TCS_CONFIG" "$TCS_DATA" "$TCS_CERTS" "$TCS_LOG"
info "Created data directories"

# Config file
if [ ! -f "$TCS_CONFIG" ]; then
    cp "${EXTRACT_DIR}/config.example.toml" "$TCS_CONFIG"
    info "Created default config at ${TCS_CONFIG}"
else
    warn "Existing config found at ${TCS_CONFIG}, leaving unchanged"
fi

# Systemd unit
cat > "$SYSTEMD_UNIT" << 'UNIT'
[Unit]
Description=Talos Control System
Documentation=https://github.com/aedan/talos-control-system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tcs
Restart=always
RestartSec=5
EnvironmentFile=-/etc/tcs/env

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/tcs /var/log/tcs
ConfigurationDirectory=tcs
LogsDirectory=tcs

[Install]
WantedBy=multi-user.target
UNIT

info "Installed systemd unit at ${SYSTEMD_UNIT}"

# Clean up
rm -rf "$EXTRACT_DIR"

# Reload and enable
systemctl daemon-reload
systemctl enable tcs.service

# Start
info "Starting TCS service..."
systemctl start tcs.service

info "Done! TCS v${TCS_VERSION} is running."
info ""
info "  Config:   ${TCS_CONFIG}"
info "  Data:     ${TCS_DATA}"
info "  Logs:     journalctl -u tcs"
info "  Status:   systemctl status tcs"
info ""
info "On first boot, the default admin password is printed to the journal:"
info "  journalctl -u tcs -n 50 | grep password"
